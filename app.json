      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDbx1scguWeUrv-OMJyjLLheiuDnN2WNX0"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",

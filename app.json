{
  "expo": {
    "name": "Aqui Tem Delivery",
    "slug": "Aqui Tem Delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ccc"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.aquitemdelivery",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "O Aqui Tem Delivery precisa acessar sua câmera para tirar fotos de produtos.",
        "NSPhotoLibraryUsageDescription": "O Aqui Tem Delivery precisa acessar suas fotos para enviar imagens de produtos.",
        "NSLocationWhenInUseUsageDescription": "O Aqui Tem Delivery precisa da sua localização para encontrar lojas e entregas próximas."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyDbx1scguWeUrv-OMJyjLLheiuDnN2WNX0"
      }
    },
    "android": {
      "package": "br.com.aquitemdelivery",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDbx1scguWeUrv-OMJyjLLheiuDnN2WNX0"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "O Aqui Tem Delivery precisa acessar sua câmera para tirar fotos de produtos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Aqui Tem Delivery precisa acessar suas fotos para enviar imagens de produtos.",
          "cameraPermission": "O Aqui Tem Delivery precisa acessar sua câmera para tirar fotos de produtos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "SEU_PROJECT_ID_AQUI"
      }
    }
  }
}

        "NSLocationWhenInUseUsageDescription": "O Compranomia Delivery precisa da sua localização para encontrar lojas e entregas próximas.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyDbx1scguWeUrv-OMJyjLLheiuDnN2WNX0"
      }
    },
    "android": {
      "package": "br.com.compranomia",
      "versionCode": 1,
